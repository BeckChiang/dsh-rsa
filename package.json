{
  "name": "dsh-rsa",
  "version": "0.2.1",
  "description": "Configurable startup splash screen for DeepSeek Harness desktop on Windows only — real main-process animation with live preview, light/dark themes, and a one-click deep deploy into app.asar.",
  "type": "module",
  "license": "MIT",
  "author": "BeckChiang",
  "homepage": "https://github.com/BeckChiang/dsh-rsa#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BeckChiang/dsh-rsa.git"
  },
  "bugs": {
    "url": "https://github.com/BeckChiang/dsh-rsa/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "splash",
    "splash-screen",
    "startup",
    "animation",
    "electron"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib/**/*",
    "locale/*.json",
    "icon.svg",
    "docs/media/*.gif"
  ],
  "scripts": {
    "test": "node --test"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
